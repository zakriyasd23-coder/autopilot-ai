{
  "name": "autopilot-ai",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "workspaces": [
    "shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start:test": "pnpm --filter @autopilot/server start:test",
    "test:integration": "jest -c tests/jest.integration.config.cjs"
  },
  "devDependencies": {
    "@types/express-session": "^1.19.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "autoprefixer": "^10.5.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "postcss": "^8.5.14",
    "supertest": "^6.3.4",
    "tailwindcss": "3.4.10",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}